<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>{{ meta.lesson_name }}</title>
<style>
  :root {
    --blue: #1B4F9B;
    --blue-dark: #143a73;
    --orange: #F07B3F;
    --dark: #2C2C2C;
    --light: #F5F7FA;
    --muted: #6B7280;
    --placeholder: #DDDDDD;

    --bloom-remember:    #78909C;
    --bloom-understand:  #43A047;
    --bloom-apply:       #1E88E5;
    --bloom-analyze:     #8E24AA;
    --bloom-evaluate:    #F4511E;
    --bloom-create:      #C62828;
  }

  @page { size: 16in 9in; margin: 0; }
  html, body { margin: 0; padding: 0; background: white; color: var(--dark); }
  body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }

  .slide {
    width: 16in;
    height: 9in;
    page-break-after: always;
    background: var(--light);
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }
  .slide:last-child { page-break-after: auto; }

  .header-bar {
    height: 1.1in;
    background: var(--blue);
    display: flex;
    align-items: center;
    padding: 0 0.6in;
    color: white;
  }
  .header-bar h1 {
    font-size: 32pt;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .footer-bar {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 0.18in;
    background: var(--orange);
  }

  .body {
    padding: 0.5in 0.6in;
  }

  ul.bullets {
    margin: 0;
    padding-left: 1.4em;
  }
  ul.bullets li {
    font-size: 18pt;
    line-height: 1.45;
    margin-bottom: 0.35em;
    color: var(--dark);
  }

  .badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12pt;
    font-weight: 600;
    color: white;
    margin-right: 8px;
  }
  .badge--orange { background: var(--orange); }
  .badge--blue { background: var(--blue); }

  .visual-frame {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    border-radius: 12px;
    overflow: hidden;
  }
  .visual-frame img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .visual-placeholder {
    width: 100%;
    height: 100%;
    background: var(--placeholder);
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-style: italic;
    font-size: 14pt;
  }

  .flagged-banner {
    position: absolute;
    top: 1.3in;
    right: 0.6in;
    background: #FEF3C7;
    color: #92400E;
    border: 1px solid #F59E0B;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 10pt;
    font-weight: 600;
  }
</style>
</head>
<body>
{% for slide in deck.slides %}
{% include 'layouts/' ~ slide.layout ~ '.html.j2' %}
{% endfor %}
</body>
</html>
