<section class="slide layout--two-col" data-index="{{ slide.index }}">
  <div class="header-bar"><h1>{{ slide.title }}</h1></div>
  {% if slide.visual_status == "flagged" %}
    <div class="flagged-banner">⚠ Visual flagged for review</div>
  {% endif %}
  <div class="body" style="display: flex; gap: 0.5in; height: calc(9in - 1.1in - 0.18in);">
    <div style="flex: 1; padding-top: 0.2in;">
      <ul class="bullets">
        {% for b in slide.bullets %}<li>{{ b }}</li>{% endfor %}
      </ul>
    </div>
    <div style="flex: 1; height: 100%;">
      {% if slide.visual_status in ('approved', 'flagged') and slide.visual_path %}
        <div class="visual-frame">
          <img src="file://{{ slide.visual_path }}" alt="Slide visual">
        </div>
      {% else %}
        <div class="visual-placeholder">No visual available</div>
      {% endif %}
    </div>
  </div>
  <div class="footer-bar"></div>
</section>
