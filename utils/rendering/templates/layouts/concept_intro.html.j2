<section class="slide layout--concept-intro" data-index="{{ slide.index }}">
  <div class="header-bar"><h1>{{ slide.title }}</h1></div>
  <div class="body">
    {% if slide.bullets %}
      <p style="font-size: 22pt; color: var(--dark); margin: 0 0 0.4in 0; font-weight: 500;">
        {{ slide.bullets[0] }}
      </p>
      {% if slide.bullets | length > 1 %}
        <ul class="bullets">
          {% for b in slide.bullets[1:] %}<li>{{ b }}</li>{% endfor %}
        </ul>
      {% endif %}
    {% endif %}

    {% if slide.prerequisites %}
      <div style="position: absolute; bottom: 0.6in; left: 0.6in;">
        <span class="badge badge--orange">Prerequisites:</span>
        <span style="color: var(--dark); font-size: 13pt;">
          {{ slide.prerequisites | join(', ') }}
        </span>
      </div>
    {% endif %}
  </div>
  <div class="footer-bar"></div>
</section>
