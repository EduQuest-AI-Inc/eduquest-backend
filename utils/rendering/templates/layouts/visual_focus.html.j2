<section class="slide layout--visual-focus" data-index="{{ slide.index }}">
  <div class="header-bar"><h1>{{ slide.title }}</h1></div>
  {% if slide.visual_status == "flagged" %}
    <div class="flagged-banner">⚠ Visual flagged for review</div>
  {% endif %}
  <div class="body" style="display: flex; flex-direction: column; height: calc(9in - 1.1in - 0.18in); padding-bottom: 0.4in;">
    <div style="flex: 1; min-height: 0;">
      {% if slide.visual_status in ('approved', 'flagged') and image_data_uris.get(slide.index) %}
        <div class="visual-frame">
          <img src="{{ image_data_uris[slide.index] }}" alt="Slide visual">
        </div>
      {% else %}
        <div class="visual-placeholder">No visual available</div>
      {% endif %}
    </div>
    {% set caption = slide.visual_caption or (slide.bullets[0] if slide.bullets else '') %}
    {% if caption %}
      <p style="text-align: center; font-size: 16pt; color: var(--dark); margin: 0.3in 0 0 0; font-style: italic;">
        {{ caption }}
      </p>
    {% endif %}
  </div>
  <div class="footer-bar"></div>
</section>
