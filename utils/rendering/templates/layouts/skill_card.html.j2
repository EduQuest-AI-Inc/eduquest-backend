<section class="slide layout--skill-card" data-index="{{ slide.index }}">
  <div class="header-bar"><h1>{{ slide.title }}</h1></div>
  <div class="body">
    <div style="margin-bottom: 0.4in;">
      {% if slide.bloom_level %}
        {% set bloom_key = slide.bloom_level | lower %}
        <span class="badge"
              style="background: var(--bloom-{{ bloom_key }}, var(--blue));">
          Bloom: {{ slide.bloom_level }}
        </span>
      {% endif %}
      {% if slide.difficulty %}
        <span class="badge badge--orange">Difficulty: {{ slide.difficulty }}</span>
      {% endif %}
    </div>
    <h2 style="font-size: 18pt; color: var(--blue); margin: 0 0 0.15in 0;">
      What mastery looks like
    </h2>
    <ul class="bullets">
      {% for b in slide.bullets %}<li>{{ b }}</li>{% endfor %}
    </ul>
  </div>
  <div class="footer-bar"></div>
</section>
