OPENAI_API_KEY=sk-...

# Google Gemini "Nano Banana" image generation.
# GEMINI_API_KEY (preferred) or GOOGLE_API_KEY is required for slide images.
GEMINI_API_KEY=...

# Optional: override the default image model.
# Defaults to gemini-2.5-flash-image. Other options:
#   gemini-3.1-flash-image-preview  (Nano Banana 2)
#   gemini-3-pro-image-preview      (Nano Banana Pro)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
